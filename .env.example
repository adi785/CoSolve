# ==============================================================
# SAMARTHYA SOCIETAL CHALLENGE COORDINATION PLATFORM
# Environment Configuration Template
# ==============================================================

# Database
# For SQLite (default development): sqlite:///./samarthya.db
# For Supabase / PostgreSQL: postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./samarthya.db

# Authentication & Security
SECRET_KEY=your_super_secret_jwt_signing_key_min_32_characters_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Optional: if empty, high-fidelity deterministic mock mode is used)
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# Storage Directory
UPLOAD_DIR=./uploads

# Environment
ENVIRONMENT=development
VITE_API_BASE_URL=http://localhost:8000
